{
  "name": "innvela-desktop",
  "productName": "Innvela Hotel Desk",
  "version": "1.0.0",
  "description": "Offline hotel management software for Windows: bookings, calendar, check-in/out, GST bills, payments, ID checks, housekeeping, staff sign-ins, WhatsApp messages and reports. All data stays on the computer.",
  "author": "Innvela",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/check-license-key.mjs && tsc --noEmit && vite build && node scripts/build-main.mjs",
    "build:demo": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=cjs --outdir=.test-build --log-level=warning && node --test .test-build/*.test.js",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "license:init": "node tools/license/init-keys.mjs",
    "license:new": "node tools/license/new-license.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.77.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  },
  "build": {
    "appId": "com.innvela.hoteldesk",
    "productName": "Innvela Hotel Desk",
    "copyright": "Copyright © Innvela",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Innvela-Hotel-Desk-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Innvela Hotel Desk",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Innvela-Hotel-Desk-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Innvela-Hotel-Desk-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
